  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('startsAt')) {",
          "  const start = new Date(Date.now() + 5 * 86400000); start.setUTCMilliseconds(0);",
          "  pm.collectionVariables.set('startsAt', start.toISOString());",
          "  pm.collectionVariables.set('endsAt', new Date(+start + 3 * 3600000).toISOString());",
          "  pm.collectionVariables.set('rescheduledStartsAt', new Date(+start + 3600000).toISOString());",
          "  pm.collectionVariables.set('from', start.toISOString());",
          "  pm.collectionVariables.set('to', new Date(+start + 7 * 86400000).toISOString());",
          "}"
        ]
      }
    }
